# --- Supabase ---
# Project URL from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# The SERVICE ROLE key (keep secret — bypasses Row Level Security). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin auth ---
# A long random string. Required in the "x-api-key" header for write endpoints
# (creating/updating/deleting projects & blog posts, reading contact messages).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- CORS ---
# Comma-separated list of allowed frontend origins. Use * to allow all (dev only).
ALLOWED_ORIGINS=http://localhost:5500,https://your-portfolio-domain.com

# --- Chatbot (Groq) ---
# Free API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional. Defaults to openai/gpt-oss-120b. Must be a model Groq still serves:
# list them with  curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=openai/gpt-oss-120b

# --- Server ---
PORT=3000
